
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>سلسلة قصص القرآن - الشيخ سعيد مصطفى دياب</title>

<link rel="stylesheet" href="css/style.css">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
<link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;700;900&display=swap" rel="stylesheet">

<style>
:root{
    --primary:#0f766e;
    --gold:#c8a44d;
    --accent-light-blue:#dff6ff;
}

body {
    margin: 0;
    padding: 0;
    font-family: 'Cairo', sans-serif;
    background: #f4f7f9;
    color: #333;
}

.container {
    max-width: 900px;
    margin: 40px auto;
    padding: 0 20px 60px;
}

.page-header-box {
    background: white;
    padding: 30px;
    border-radius: 15px;
    text-align: center;
    box-shadow: 0 4px 15px rgba(0,0,0,0.05);
    border-right: 10px solid #8b5cf6; /* لون مميز لقصص القرآن */
    margin-bottom: 30px;
}

.page-title {
    color: var(--primary);
    font-weight: 900;
    font-size: 2.2rem;
    margin: 0 0 10px 0;
}

.page-subtitle {
    color: #666;
    font-weight: 700;
    font-size: 1.1rem;
}

.lessons-card {
    background: white;
    border-radius: 15px;
    padding: 10px 20px;
    box-shadow: 0 4px 15px rgba(0,0,0,0.05);
    border: 1px solid #ddd;
}

/* تنسيق سطور الدروس المطور */
.lesson-row {
    padding: 15px 0;
    border-bottom: 1px solid #f0f0f0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 15px;
}

.lesson-row:last-child {
    border-bottom: none;
}

.lesson-right {
    flex: 1.5;
    font-weight: 700;
    color: var(--primary);
    display: flex;
    align-items: center;
    gap: 10px;
}

/* الأيقونة ثلاثية الأبعاد الأزرق الفاتح */
.lesson-right i {
    color: #4dafff;
    text-shadow: 1px 1px 0px #2575fc, 2px 2px 3px rgba(0,0,0,0.15);
    font-size: 1.2rem;
}

.audio-part {
    flex: 4;
}

audio {
    width: 100%;
    height: 36px;
}

/* زر التحميل الـ 3D المطور */
.btn-download {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 35px;
    height: 35px;
    background: linear-gradient(145deg, #60a5fa, #3b82f6);
    color: white !important;
    border-radius: 50%;
    text-decoration: none;
    font-size: 1rem;
    box-shadow: 0 3px 0 #1d4ed8, 
                0 4px 6px rgba(0, 0, 0, 0.2);
    transition: transform 0.1s ease, box-shadow 0.1s ease;
}

.btn-download:active {
    transform: translateY(2px);
    box-shadow: 0 1px 0 #1d4ed8, 
                0 2px 3px rgba(0, 0, 0, 0.2);
}

/* أزرار الصفحات */
.pagination {
    display: flex;
    justify-content: center;
    gap: 8px;
    margin-top: 25px;
}

.page-btn {
    width: 38px;
    height: 38px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 8px;
    cursor: pointer;
    border: 1px solid var(--primary);
    font-weight: bold;
    color: var(--primary);
    background: white;
    transition: 0.3s;
}

.page-btn.active, .page-btn:hover {
    background: var(--primary);
    color: white;
}

.back-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    text-decoration: none;
    color: var(--primary);
    font-weight: bold;
    margin-bottom: 20px;
    transition: 0.2s;
}
.back-btn:hover {
    color: var(--gold);
}

@media (max-width:768px){
    .lesson-row{
        flex-direction: column;
        text-align: center;
        padding: 20px 0;
    }
}
</style>
</head>
<body>

<div class="container">
    
    <a href="quran-sciences.html" class="back-btn">
        <i class="fas fa-arrow-right"></i> العودة لعلوم القرآن الكريم
    </a>

    <div class="page-header-box">
        <h1 class="page-title">سلسلة قصص القرآن</h1>
        <div class="page-subtitle">فضيلة الشيخ سعيد مصطفى دياب (62 درساً)</div>
    </div>

    <div class="lessons-card">
        <div id="lessons-list"></div>
        <div class="pagination" id="pagination-container"></div>
    </div>

</div>

<script>
// إعدادات السلسلة والملفات الصوتية
const config = {
    prefix: 'qass-al-qoran', // بادئة اسم ملف الصوت كما هي لديك
    count: 62,               // إجمالي عدد الدروس
    perPage: 10,             // عدد الدروس في كل صفحة
    currentPage: 1
};

function renderLessons() {
    const listContainer = document.getElementById('lessons-list');
    const paginationContainer = document.getElementById('pagination-container');
    
    listContainer.innerHTML = "";
    
    // حساب بداية ونهاية الدروس للصفحة الحالية
    const start = (config.currentPage - 1) * config.perPage + 1;
    const end = Math.min(config.currentPage * config.perPage, config.count);
    
    for (let i = start; i <= end; i++) {
        listContainer.innerHTML += `
        <div class="lesson-row">
            <div class="lesson-right">
                <i class="fas fa-play-circle"></i>
                الدرس (${i})
            </div>
            <div class="audio-part">
                <audio controls preload="none">
                    <source src="audio/${config.prefix}-${i}.mp3" type="audio/mpeg">
                </audio>
            </div>
            <div>
                <a href="audio/${config.prefix}-${i}.mp3" download class="btn-download">
                    <i class="fas fa-arrow-down"></i>
                </a>
            </div>
        </div>
        `;
    }
    
    // إنشاء أزرار التنقل بين الصفحات
    const totalPages = Math.ceil(config.count / config.perPage);
    paginationContainer.innerHTML = "";
    
    if (totalPages > 1) {
        for (let p = 1; p <= totalPages; p++) {
            const btn = document.createElement('div');
            btn.className = `page-btn ${p === config.currentPage ? 'active' : ''}`;
            btn.innerText = p;
            btn.onclick = () => {
                config.currentPage = p;
                renderLessons();
                window.scrollTo({top: 0, behavior: 'smooth'}); // رفع الصفحة للأعلى عند التنقل
            };
            paginationContainer.appendChild(btn);
        }
    }
}

// تشغيل الدالة فور تحميل الصفحة
window.onload = renderLessons;
</script>

</body>
</html>
