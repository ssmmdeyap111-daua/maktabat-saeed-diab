/* ===== إعدادات عامة ===== */
* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

body {
    font-family: 'Reem Kufi Ink', sans-serif;
    background: #f9f9f9;
    color: #222;
    line-height: 1.8;
}

/* ===== الشريط الأخضر ===== */
.header-bar {
    background: linear-gradient(to bottom, #0a7a3c, #0e8f4a);
    padding: 30px 20px 20px;
    text-align: center;
}

/* اسم الموقع */
.site-name-hand {
    color: #fff;
    font-size: 2.6rem;
    margin-bottom: 18px;
}

/* ===== الأيقونات ===== */
.icon-grid {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 14px;
    flex-wrap: nowrap;
}

.icon-item {
    background: rgba(255,255,255,0.15);
    color: #fff;
    padding: 10px 18px;
    border-radius: 30px;
    font-size: 1.1rem;
    text-decoration: none;
    white-space: nowrap;
    transition: 0.3s;
}

.icon-item:hover {
    background: #1f7a4d;
    transform: translateY(-2px);
}

/* ===== الشريط المتحرك ===== */
.marquee-container {
    margin: 30px auto;
    max-width: 80%;
    background: #fff7d6;
    border: 2px solid #d4af37;
    border-radius: 40px;
    padding: 14px;
    overflow: hidden;
}

.marquee-text {
    font-size: 1.5rem;
    font-weight: bold;
    color: #006400;
    white-space: nowrap;
    animation: move 25s linear infinite;
}

@keyframes move {
    from { transform: translateX(-100%); }
    to   { transform: translateX(100%); }
}

/* ===== البحث ===== */
.main-search-wrapper {
    margin: 50px auto;
    text-align: center;
}

.main-search input {
    width: 320px;
    padding: 14px;
    font-size: 1.2rem;
    border-radius: 30px;
    border: 2px solid #0a7a3c;
    outline: none;
}

/* ===== عنوان الأقسام ===== */
.section-title {
    text-align: center;
    color: #006400;
    font-size: 2.5rem;
    margin: 50px 0 30px;
}

/* ===== شريط الكتب (الرئيسية) ===== */
.books-slider-wrapper {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 20px;
    overflow: hidden;
}

.books-slider {
    display: flex;
    gap: 20px;
    overflow-x: auto;
    scroll-behavior: smooth;
}

.book {
    min-width: 180px;
    text-align: center;
}

.book img {
    width: 160px;
    border-radius: 10px;
}

.book h3 {
    font-size: 1rem;
    margin-top: 10px;
}

/* ===== صفحة الكتب ===== */
.books-page-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
    gap: 25px;
    padding: 40px;
}

.book-card {
    background: #fff;
    border-radius: 12px;
    padding: 15px;
    text-align: center;
    text-decoration: none;
    color: #222;
    transition: 0.3s;
}

.book-card img {
    width: 150px;
    margin-bottom: 10px;
}

.book-card:hover {
    transform: translateY(-5px);
}

/* ===== العودة للرئيسية ===== */
.back-home-wrapper {
    text-align: right;
    padding: 30px;
}

.back-home {
    font-size: 1.3rem;
    color: #0a7a3c;
    text-decoration: none;
}
body {
    margin: 0;
    font-family: "Arial", sans-serif;
    background-color: #f9f9f9;
}

/* شبكة الأيقونات المستطيلة للكتب */
.icon-grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    margin: 40px 10px;
    gap: 25px;
}

.icon-item {
    width: 160px;
    height: 180px;
    background-color: #e0ffe0;
    border: 3px solid #006400;
    display: flex;
    justify-content: center;
    align-items: center;
    text-align: center;
    font-weight: bold;
    color: #006400;
    font-size: 1.8rem;
    border-radius: 20px;
    cursor: pointer;
    text-decoration: none;
    box-shadow:
        0 12px 25px rgba(0,0,0,0.35),
        inset 0 3px 6px rgba(255,255,255,0.8);
    transition: all 0.3s ease;
}

.icon-item:hover {
    background-color: #c8f0c8;
    box-shadow:
        0 15px 30px rgba(0,0,0,0.45),
        inset 0 4px 8px rgba(255,255,255,0.85);
}

/* زر العودة */
.back-home {
    display: flex;
    justify-content: center;
    margin: 50px 0;
}

.back-home a {
    width: 180px;
    height: 100px;
    background-color: #e0ffe0;
    border: 3px solid #006400;
    display: flex;
    justify-content: center;
    align-items: center;
    text-align: center;
    font-weight: bold;
    color: #006400;
    font-size: 2rem;
    border-radius: 20px;
    cursor: pointer;
    text-decoration: none;
    box-shadow:
        0 12px 25px rgba(0,0,0,0.35),
        inset 0 3px 6px rgba(255,255,255,0.8);
    transition: all 0.3s ease;
}

.back-home a:hover {
    background-color: #c8f0c8;
    box-shadow:
        0 15px 30px rgba(0,0,0,0.45),
        inset 0 4px 8px rgba(255,255,255,0.85);
}

.book-title {
    margin-top: 10px;
    font-size: 1.1rem;
    color: #006400;
    text-align: center;
}
